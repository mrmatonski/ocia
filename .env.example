# Ask St. Mary OCIA — server-side only. Never prefix with NEXT_PUBLIC_.
# When set, the assistant uses the OpenAI Responses API.
# Without a key, it answers from site knowledge and public sources.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Contact form (server-side only — never prefix these with NEXT_PUBLIC_)
# Delivered to this inbox. CONTACT_EMAIL is preferred; CONTACT_TO_EMAIL is also read.
CONTACT_EMAIL=mrmatonski@icloud.com
CONTACT_TO_EMAIL=mrmatonski@icloud.com

# From address. Leave unset until a sending domain is verified in Resend.
# Unverified domains must use Resend's test sender (onboarding@resend.dev),
# which the app uses automatically when this variable is empty.
# After verifying stmary-ocia.com in Resend, set:
# CONTACT_FROM_EMAIL="St. Mary OCIA <noreply@stmary-ocia.com>"
CONTACT_FROM_EMAIL=

# Resend (https://resend.com). Required for production email unless SMTP_* is set.
# Add the same key in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=

# Or SMTP (for example Google Workspace). Used only when RESEND_API_KEY is unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="St. Mary OCIA <noreply@stmary-ocia.com>"
